{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "recall-studio",
  "version": "0.1.0",
  "identifier": "com.gberg.recall-studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "recall-studio",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../m4l/recall-studio.amxd": "bridge/recall-studio.amxd",
      "../m4l/recall_m4l_bridge.js": "bridge/recall_m4l_bridge.js"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
